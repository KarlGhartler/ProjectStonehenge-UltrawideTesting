#version 450
// GS frame buffer read in another pixel format (src/platform/render/gs/gs_vulkan.cpp, Convert): builds
// the texture a draw asks for (TEX0 PSM, TBP, TBW) from a render target that holds the same local
// memory in another format or buffer width, through the GS local memory layout
// (docs/platform/gs-subset.md). For each texel: its byte address from the texture format's page
// table, then the target pixel that holds that address from the target format's inverse table, the
// bits of that pixel, and the texel's RGBA (CLUT for the paletted formats, TEXA for 16/24 bit).

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D src;  // the target (RGBA8: CT32 bytes, or CT16 colour in 5-bit steps)
layout(std430, binding = 1) readonly buffer Tables { uint t[]; } tables;
layout(std430, binding = 2) readonly buffer Clut { uint c[]; } clut;  // 256 RGBA8 entries
layout(binding = 3, rgba8) uniform writeonly image2D dst;

layout(push_constant) uniform Params {
    int src_psm;   // 0x00 CT32/CT24 layout, 0x02 CT16, 0x0A CT16S
    int src_fbp;   // pages
    int src_fbw;   // 64-pixel units
    int dst_psm;
    int dst_tbp;   // blocks
    int dst_tbw;   // 64-pixel units
    ivec2 origin;  // first texel converted
    ivec2 size;    // texels converted
    ivec2 src_size;
    int texa;      // TA0 bits 0-7, AEM bit 15, TA1 bits 16-23
} pc;

// Offsets of the tables in the buffer (gs_vulkan.cpp BuildConvTables, same order).
const uint kFwd32 = 0u;                 // CT32 page 64x32 -> word in page
const uint kFwd16 = kFwd32 + 2048u;     // CT16 page 64x64 -> halfword
const uint kFwd16S = kFwd16 + 4096u;    // CT16S
const uint kFwd8 = kFwd16S + 4096u;     // T8 page 128x64 -> byte
const uint kFwd4 = kFwd8 + 8192u;       // T4 page 128x128 -> nibble
const uint kInv32 = kFwd4 + 16384u;     // word in page -> x | y << 8
const uint kInv16 = kInv32 + 2048u;     // halfword -> x | y << 8
const uint kInv16S = kInv16 + 4096u;

// Raw bits of the target pixel that holds byte address `addr` (aligned to the target's pixel size),
// or 0 outside the target.
uint SrcPixel(uint addr) {
    bool is32 = pc.src_psm == 0 || pc.src_psm == 1;
    uint page = addr >> 13;
    int p = int(page) - pc.src_fbp;
    if (p < 0) return 0u;
    int ppr = max(pc.src_fbw, 1);
    uint inpage = addr & 8191u;
    uint xy;
    int ph;
    if (is32) {
        xy = tables.t[kInv32 + (inpage >> 2)];
        ph = 32;
    } else {
        xy = tables.t[(pc.src_psm == 0x0A ? kInv16S : kInv16) + (inpage >> 1)];
        ph = 64;
    }
    ivec2 pos = ivec2((p % ppr) * 64 + int(xy & 0xFFu), (p / ppr) * ph + int(xy >> 8));
    if (pos.x >= pc.src_size.x || pos.y >= pc.src_size.y) return 0u;
    uvec4 v = uvec4(floor(texelFetch(src, pos, 0) * 255.0 + 0.5));
    if (is32) return v.r | v.g << 8 | v.b << 16 | v.a << 24;
    return (v.r >> 3) | (v.g >> 3) << 5 | (v.b >> 3) << 10 | (v.a >= 128u ? 0x8000u : 0u);
}

uint SrcByte(uint addr) {
    bool is32 = pc.src_psm == 0 || pc.src_psm == 1;
    uint raw = SrcPixel(is32 ? (addr & ~3u) : (addr & ~1u));
    uint shift = is32 ? (addr & 3u) * 8u : (addr & 1u) * 8u;
    return (raw >> shift) & 0xFFu;
}

uint From16(uint p) {
    uint ta0 = uint(pc.texa) & 0xFFu, ta1 = (uint(pc.texa) >> 16) & 0xFFu;
    bool aem = (pc.texa & 0x8000) != 0;
    uint a = (p & 0x8000u) != 0u ? ta1 : ta0;
    if (aem && (p & 0x7FFFu) == 0u) a = 0u;
    return ((p & 0x1Fu) << 3) | (((p >> 5) & 0x1Fu) << 11) | (((p >> 10) & 0x1Fu) << 19) | (a << 24);
}

void main() {
    ivec2 g = ivec2(gl_GlobalInvocationID.xy);
    if (g.x >= pc.size.x || g.y >= pc.size.y) return;
    ivec2 uv = pc.origin + g;
    int psm = pc.dst_psm;
    // Page geometry of the texture format.
    int pw = 64, ph = 32;
    if (psm == 0x02 || psm == 0x0A) ph = 64;
    else if (psm == 0x13) { pw = 128; ph = 64; }
    else if (psm == 0x14) { pw = 128; ph = 128; }
    int ppr = max(pc.dst_tbw * 64 / pw, 1);
    uint page = uint((uv.y / ph) * ppr + uv.x / pw);
    uint px = uint(uv.x % pw), py = uint(uv.y % ph);
    uint base = uint(pc.dst_tbp) * 256u + page * 8192u;
    uint rgba;
    if (psm == 0x13 || psm == 0x14) {
        uint index;
        if (psm == 0x13) {
            index = SrcByte(base + tables.t[kFwd8 + py * 128u + px]);
        } else {
            uint nib = base * 2u + tables.t[kFwd4 + py * 128u + px];
            index = (SrcByte(nib >> 1) >> ((nib & 1u) * 4u)) & 0xFu;
        }
        rgba = clut.c[index];
    } else if (psm == 0x02 || psm == 0x0A) {
        uint a = base + tables.t[(psm == 0x0A ? kFwd16S : kFwd16) + py * 64u + px] * 2u;
        rgba = From16(SrcByte(a) | SrcByte(a + 1u) << 8);
    } else {
        // 32-bit layout: CT32, CT24 and the high-bit palette formats T8H, T4HL, T4HH.
        uint a = base + tables.t[kFwd32 + py * 64u + px] * 4u;
        uint raw = SrcByte(a) | SrcByte(a + 1u) << 8 | SrcByte(a + 2u) << 16 | SrcByte(a + 3u) << 24;
        if (psm == 0x1B) {
            rgba = clut.c[raw >> 24];
        } else if (psm == 0x24) {
            rgba = clut.c[(raw >> 24) & 0xFu];
        } else if (psm == 0x2C) {
            rgba = clut.c[raw >> 28];
        } else if (psm == 0x01) {
            uint ta0 = uint(pc.texa) & 0xFFu;
            bool aem = (pc.texa & 0x8000) != 0;
            uint al = (aem && (raw & 0xFFFFFFu) == 0u) ? 0u : ta0;
            rgba = (raw & 0xFFFFFFu) | (al << 24);
        } else {
            rgba = raw;
        }
    }
    imageStore(dst, uv, unpackUnorm4x8(rgba));
}
