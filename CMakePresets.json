{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows",
      "displayName": "Windows (Visual Studio 2026, x64)",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "windows", "configuration": "Debug" },
    { "name": "dev",     "configurePreset": "windows", "configuration": "RelWithDebInfo" },
    { "name": "release", "configurePreset": "windows", "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "debug",   "configurePreset": "windows", "configuration": "Debug",          "output": { "outputOnFailure": true } },
    { "name": "dev",     "configurePreset": "windows", "configuration": "RelWithDebInfo", "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "windows", "configuration": "Release",        "output": { "outputOnFailure": true } }
  ]
}
